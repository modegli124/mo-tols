    <script>
        const fi = document.getElementById('imageFile'), dz = document.getElementById('dropzone'), q = document.getElementById('quality'), qv = document.getElementById('qualityValue'), qv2 = document.getElementById('qualityValue2'), fmt = document.getElementById('format'), mx = document.getElementById('maxSize'), fn = document.getElementById('fileName'), btn = document.getElementById('compressBtn'), msg = document.getElementById('message'), stats = document.getElementById('stats'), preview = document.getElementById('preview'), actions = document.getElementById('actions');
        q.oninput = () => { qv.textContent = q.value + '%'; qv2.textContent = q.value + '%'; };
        fi.onchange = () => { const f = fi.files[0]; if (f && !fn.value) fn.value = f.name.replace(/\.[^.]+$/, '') + '-compressed'; };
        ['dragenter', 'dragover'].forEach(e => dz.addEventListener(e, x => { x.preventDefault(); dz.classList.add('dragover'); }));
        ['dragleave', 'drop'].forEach(e => dz.addEventListener(e, x => { x.preventDefault(); dz.classList.remove('dragover'); }));
        dz.addEventListener('drop', e => { const f = e.dataTransfer.files[0]; if (f && f.type.startsWith('image/')) { const dt = new DataTransfer(); dt.items.add(f); fi.files = dt.files; fi.dispatchEvent(new Event('change')); } });
        function sz(b) { return b < 1024 ? b + ' B' : b < 1048576 ? (b / 1024).toFixed(1) + ' KB' : (b / 1048576).toFixed(2) + ' MB'; }
        btn.onclick = () => {
            const f = fi.files[0]; msg.hidden = false; actions.innerHTML = ''; stats.hidden = true; preview.innerHTML = '';
            if (!f) { msg.textContent = 'اختر صورة أولًا.'; msg.className = 'result error'; return; }
            if (f.size > 25 * 1024 * 1024) { msg.textContent = 'حجم الملف أكبر من 25MB.'; msg.className = 'result error'; return; }
            const r = new FileReader();
            r.onload = e => {
                const i = new Image();
                i.onload = () => {
                    let w = i.naturalWidth, h = i.naturalHeight, m = parseInt(mx.value, 10);
                    if (Number.isFinite(m) && m > 0 && Math.max(w, h) > m) {
                        const sc = m / Math.max(w, h); w = Math.round(w * sc); h = Math.round(h * sc);
                    }
                    const c = document.createElement('canvas'); c.width = w; c.height = h;
                    c.getContext('2d').drawImage(i, 0, 0, w, h);
                    const t = fmt.value;
                    c.toBlob(b => {
                        if (!b) { msg.textContent = 'تعذر إنشاء الصورة.'; msg.className = 'result error'; return; }
                        const u = URL.createObjectURL(b), ext = t === 'image/png' ? 'png' : t === 'image/jpeg' ? 'jpg' : 'webp', save = Math.max(0, (f.size - b.size) / f.size * 100);
                        document.getElementById('before').textContent = sz(f.size);
                        document.getElementById('after').textContent = sz(b.size);
                        document.getElementById('saved').textContent = save.toFixed(1) + '%';
                        stats.hidden = false; msg.textContent = 'تم ضغط الصورة بنجاح.'; msg.className = 'result success';
                        const im = document.createElement('img'); im.src = u; im.alt = 'معاينة الصورة بعد الضغط'; preview.appendChild(im);
                        const a = document.createElement('a'); a.href = u; a.download = (fn.value.trim() || 'modegli-compressed') + '.' + ext; a.className = 'btn'; a.textContent = 'تحميل الصورة'; actions.appendChild(a);
                    }, t, Number(q.value) / 100);
                };
                i.src = e.target.result;
            };
            r.readAsDataURL(f);
        };
    </script>
