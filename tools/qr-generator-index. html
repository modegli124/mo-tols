<script>
const text=document.getElementById("text"),qr=document.getElementById("qr"),actions=document.getElementById("actions"),msg=document.getElementById("msg");document.getElementById("go").onclick=()=>{qr.innerHTML="";actions.innerHTML="";msg.hidden=true;if(!text.value.trim()){msg.hidden=false;msg.textContent="اكتب نصًا أو رابطًا أولًا.";return}if(typeof QRCode==="undefined"){msg.hidden=false;msg.textContent="تعذر تحميل مولد QR. تحقق من اتصال الإنترنت.";return}new QRCode(qr,{text:text.value.trim(),width:280,height:280,correctLevel:QRCode.CorrectLevel.M});setTimeout(()=>{const img=qr.querySelector("img")||qr.querySelector("canvas");if(img){const a=document.createElement("a");a.className="btn";a.textContent="تحميل QR";a.download="modegli-qr.png";if(img.tagName==="IMG")a.href=img.src;else a.href=img.toDataURL("image/png");actions.appendChild(a)}},200)};
